# Peach 1UP — secrets and deployment/environment variables.
#
# PURPOSE OF THIS FILE:
#   .env holds secrets and fixed deployment variables that belong in the
#   environment, not in user-editable config. Copy this file to .env and
#   fill in the values. Do NOT commit .env.
#
#   User-editable runtime settings (paths, flags, preferences) belong in
#   config/settings.yaml, not here.
#
# To generate SESSION_SECRET: python -c "import secrets; print(secrets.token_hex(32))"

# ── Required ─────────────────────────────────────────────────────────────────

# Session signing key. Must be a random hex string. Treat as a password.
SESSION_SECRET=

# ── Environment ──────────────────────────────────────────────────────────────

# Runtime environment. Controls log verbosity and dev tooling.
# Values: development | production
PEACH_ENV=production

# ── Deployment overrides ─────────────────────────────────────────────────────

# Allowed CORS origin for the frontend. Defaults to http://localhost:5173 when
# unset. Override in production to match the actual frontend URL.
# CORS_ORIGIN=http://localhost:5173
