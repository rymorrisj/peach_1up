# Peach 1UP Environment Configuration
# Copy this file to .env and adjust paths for your system

# Display forwarding for Docker containers (VcXsrv on Windows)
DISPLAY=host.docker.internal:0.0

# Docker images for emulators
DOSBOX_IMAGE=peach1up/dosbox-x:latest
BOX86_IMAGE=peach1up/86box:latest

# Local paths
ROM_PATH=./images/roms
PROFILES_PATH=./profiles

# Optional: Override emulator binary paths if using custom builds
# DOSBOX_BINARY=/usr/local/bin/dosbox-x
# BOX86_BINARY=/usr/local/bin/86Box