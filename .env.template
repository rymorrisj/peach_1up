# Peach 1UP — secrets and deployment/environment variables.
#
# PURPOSE OF THIS FILE:
#   .env holds secrets and fixed deployment variables that belong in the
#   environment, not in user-editable config. Copy this file to .env and
#   fill in the values. Do NOT commit .env.
#
#   User-editable runtime settings (paths, flags, preferences) live in the
#   app_settings DB table, not here — see Settings in the app UI.

# ── Environment ──────────────────────────────────────────────────────────────

# Runtime environment. Controls log verbosity and dev tooling.
# Values: development | production
PEACH_ENV=development

# ── Secrets ──────────────────────────────────────────────────────────────────

# Opt-in Argon2id PIN pepper. Empty/unset means disabled. Normally set via
# Settings > Owner in the app UI (PATCH /api/v1/settings/pin-pepper), which
# rewrites this file directly — hand-editing is only needed for recovery.
# PIN_PEPPER=

# TheGamesDB API key, used for metadata enrichment. Normally set via
# Settings > Metadata in the app UI, which rewrites this file directly.
# THEGAMESDB_API_KEY=

# Reserved for future local-LLM / AI-assisted detection features. Accepted
# and stored today (Settings > Metadata) but not yet read by any code path.
# AI_API_KEY=

# IGDB metadata enrichment (Twitch Developer app client credentials, used for
# the OAuth client-credentials token exchange). Normally set via Settings >
# Metadata in the app UI, which rewrites this file directly. The resulting
# access token is NOT stored here — it lives in app_settings (short-lived,
# silently re-minted on expiry, safe to lose on reset_db).
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# ── Deployment overrides ─────────────────────────────────────────────────────

# Allowed CORS origin for the frontend. Defaults to http://localhost:5173 when
# unset. Override in production to match the actual frontend URL.
# CORS_ORIGIN=http://localhost:5173

# Full URL where the Docusaurus docs site is reachable. Defaults to
# http://localhost:3000 when unset. Self-hosters running their own domain or
# reverse proxy should set this to that URL instead, e.g.
# https://docs.mydomain.com. The frontend dev server reads the same value via
# VITE_DOCS_BASE_URL in frontend/.env.development / frontend/.env.production —
# keep both in sync.
# DOCS_BASE_URL=http://localhost:3000
