# Peach 1UP settings template.
# Copy this file to config/settings.yaml.
# Emulator binary paths are auto-resolved from the bundled emulators/ directory
# via the three-tier model (TOML bundled path → catalog detection → settings.yaml override).
# Override a specific emulator path only if you need to use a non-bundled binary:
#
# DOSBOX_PATH: C:/path/to/your/dosbox-x.exe
# BOX86_PATH: C:/path/to/your/86Box.exe
# PCSX2_PATH: C:/path/to/your/pcsx2-qt.exe
# XEMU_PATH: C:/path/to/your/xemu.exe
# MESEN_PATH: C:/path/to/your/Mesen.exe
# DUCKSTATION_PATH: C:/path/to/your/duckstation-qt-x64-ReleaseLTCG.exe
# PROJECT64_PATH: C:/path/to/your/Project64.exe
# FLYCAST_PATH: C:/path/to/your/flycast.exe

first_run_complete: false

# Library paths — relative to project root.
LIBRARY_PATH: library
MEDIA_PATH: library/media
GAMES_PATH: library/media/games
OS_PATH: library/system/os
DRIVES_PATH: library/system/drives
ROMS_PATH: library/system/roms/86box
PROFILES_PATH: library/system/profiles

suppress_confirmations: []
PEACH_ENV: development
