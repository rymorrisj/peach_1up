# Bundled emulator binaries (drop-in, never committed. Legal/compliance files are tracked)
# Use ** (not trailing /) so git descends into the directory and evaluates the negations below
# Nested .git dirs are stripped on install; only the root .git should ever exist in this project
/emulators/**
!/emulators/*/
/emulators/**/.git
!/emulators/*/COPYING
!/emulators/*/COPYING.GPLv3
!/emulators/*/LICENSE
!/emulators/*/LICENSE.txt
!/emulators/*/license.md
!/emulators/*/SOURCE_OFFER.txt

